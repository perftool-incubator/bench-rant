#!/bin/bash
# vim: autoindent tabstop=4 shiftwidth=4 expandtab softtabstop=4 filetype=bash

exec >rant-client-stderrout.txt
exec 2>&1

. /usr/bin/rant-base || (echo "/usr/bin/rant-base not found"; exit 1)

dump_runtime
validate_label
validate_sw_prereqs jq getopt

# Defaults matching multiplex.json
duration=60
rant_bin="./rant"
interface=""
server_address=""
cpu=""
namespace=""
numa_node=""
sched_priority="2"
busy_poll_us="50"
busy_poll_budget="1"
prefer_busy_poll="1"
warmup="10000"
histogram="1"
threshold="0"
log_threshold="0"
continue_threshold="0"
trace_marker="0"
snapshot="0"
pmc="0"
hugepages="0"
no_hw_ts="0"
verbose="0"
log_file=""
overflow="100"
bucket_size="1"
stress_type=""
stress_cpus=""
stress_workers="0"
stress_membind=""

longopts="duration:,rant-bin:,interface:,server-address:,cpu:,namespace:,"
longopts+="numa-node:,sched-priority:,busy-poll-us:,busy-poll-budget:,"
longopts+="prefer-busy-poll:,warmup:,histogram:,threshold:,log-threshold:,"
longopts+="continue-threshold:,trace-marker:,snapshot:,pmc:,hugepages:,"
longopts+="no-hw-ts:,verbose:,log-file:,overflow:,bucket-size:,"
longopts+="stress-type:,stress-cpus:,stress-workers:,stress-membind:,"
# Server-only params to silently skip
longopts+="no-tx-ts:,fast-path:,threaded:"

opts=$(getopt -q -o "" --longoptions "$longopts" -n "getopt.sh" -- "$@")
eval set -- "$opts"
while true; do
    case "$1" in
        --duration)          shift; duration=$1;          shift ;;
        --rant-bin)          shift; rant_bin=$1;          shift ;;
        --interface)         shift; interface=$1;         shift ;;
        --server-address)    shift; server_address=$1;    shift ;;
        --cpu)               shift; cpu=$1;               shift ;;
        --namespace)         shift; namespace=$1;         shift ;;
        --numa-node)         shift; numa_node=$1;         shift ;;
        --sched-priority)    shift; sched_priority=$1;    shift ;;
        --busy-poll-us)      shift; busy_poll_us=$1;      shift ;;
        --busy-poll-budget)  shift; busy_poll_budget=$1;  shift ;;
        --prefer-busy-poll)  shift; prefer_busy_poll=$1;  shift ;;
        --warmup)            shift; warmup=$1;            shift ;;
        --histogram)         shift; histogram=$1;         shift ;;
        --threshold)         shift; threshold=$1;         shift ;;
        --log-threshold)     shift; log_threshold=$1;     shift ;;
        --continue-threshold) shift; continue_threshold=$1; shift ;;
        --trace-marker)      shift; trace_marker=$1;      shift ;;
        --snapshot)          shift; snapshot=$1;           shift ;;
        --pmc)               shift; pmc=$1;               shift ;;
        --hugepages)         shift; hugepages=$1;         shift ;;
        --no-hw-ts)          shift; no_hw_ts=$1;          shift ;;
        --verbose)           shift; verbose=$1;           shift ;;
        --log-file)          shift; log_file=$1;          shift ;;
        --overflow)          shift; overflow=$1;           shift ;;
        --bucket-size)       shift; bucket_size=$1;       shift ;;
        --stress-type)       shift; stress_type=$1;       shift ;;
        --stress-cpus)       shift; stress_cpus=$1;       shift ;;
        --stress-workers)    shift; stress_workers=$1;    shift ;;
        --stress-membind)    shift; stress_membind=$1;    shift ;;
        --no-tx-ts|--fast-path|--threaded)
            shift; shift ;;
        --)
            shift
            break
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$interface" ]; then
    exit_error "interface is required (--interface)"
fi

# If server-address not specified, try to read from server messages
if [ -z "$server_address" ]; then
    if [ -e "msgs/rx/svc" ]; then
        server_address=$(jq -r '.svc.ip' msgs/rx/svc)
        echo "Discovered server address from messages: $server_address"
    else
        exit_error "server-address is required (--server-address or auto-discovery via messages)"
    fi
fi

# Build rant command-line arguments
rant_args="-i $interface -a $server_address -d $duration"

if [ "$busy_poll_us" -gt 0 ] 2>/dev/null; then
    rant_args="$rant_args -p $busy_poll_us"
fi
if [ "$busy_poll_budget" -gt 0 ] 2>/dev/null; then
    rant_args="$rant_args -B $busy_poll_budget"
fi
if [ "$prefer_busy_poll" = "1" ]; then
    rant_args="$rant_args -P"
fi
if [ "$warmup" -gt 0 ] 2>/dev/null; then
    rant_args="$rant_args -w $warmup"
fi
if [ "$histogram" = "1" ]; then
    rant_args="$rant_args -H"
fi
if [ "$threshold" -gt 0 ] 2>/dev/null; then
    rant_args="$rant_args -t $threshold"
fi
if [ "$log_threshold" -gt 0 ] 2>/dev/null; then
    rant_args="$rant_args -L $log_threshold"
fi
if [ "$continue_threshold" = "1" ]; then
    rant_args="$rant_args -C"
fi
if [ "$trace_marker" = "1" ]; then
    rant_args="$rant_args -T"
fi
if [ "$snapshot" = "1" ]; then
    rant_args="$rant_args -S"
fi
if [ "$pmc" = "1" ]; then
    rant_args="$rant_args -M"
fi
if [ "$hugepages" = "1" ]; then
    rant_args="$rant_args -G"
fi
if [ "$no_hw_ts" = "1" ]; then
    rant_args="$rant_args -R"
fi
if [ "$verbose" = "1" ]; then
    rant_args="$rant_args -v"
fi
if [ -n "$log_file" ]; then
    rant_args="$rant_args -l $log_file"
fi
if [ "$overflow" != "100" ]; then
    rant_args="$rant_args -o $overflow"
fi
if [ "$bucket_size" != "1" ]; then
    rant_args="$rant_args -b $bucket_size"
fi

# Build command prefix for CPU pinning, scheduling, NUMA, and namespace
cmd_prefix=""
if [ -n "$numa_node" ]; then
    cmd_prefix="numactl --membind=$numa_node"
fi
if [ -n "$namespace" ]; then
    cmd_prefix="$cmd_prefix nsenter --net=/var/run/netns/$namespace"
fi
if [ -n "$sched_priority" ] && [ "$sched_priority" -gt 0 ] 2>/dev/null; then
    cmd_prefix="$cmd_prefix chrt -f $sched_priority"
fi
if [ -n "$cpu" ]; then
    cmd_prefix="$cmd_prefix taskset -c $cpu"
fi

echo "=== rant client configuration ==="
echo "  rant binary:      $rant_bin"
echo "  interface:        $interface"
echo "  server address:   $server_address"
echo "  duration:         $duration s"
echo "  cpu:              ${cpu:-not pinned}"
echo "  namespace:        ${namespace:-none}"
echo "  numa node:        ${numa_node:-not bound}"
echo "  sched priority:   FIFO $sched_priority"
echo "  rant args:        $rant_args"
echo "  command prefix:   ${cmd_prefix:-none}"
echo "================================="

stress_pids=""
if [ -n "$stress_type" ] && [ "$stress_workers" -gt 0 ] 2>/dev/null && [ -n "$stress_cpus" ]; then
    echo "=== starting stress-ng ==="
    echo "  type:     $stress_type"
    echo "  cpus:     $stress_cpus"
    echo "  workers:  $stress_workers"
    echo "  membind:  ${stress_membind:-none}"
    IFS=',' read -ra STRESSORS <<< "$stress_type"
    stress_prefix=""
    if [ -n "$stress_membind" ]; then
        stress_prefix="numactl --membind=$stress_membind"
    fi
    for stressor in "${STRESSORS[@]}"; do
        stress_args=""
        case "$stressor" in
            cache)   stress_args="--cache $stress_workers --cache-size 4M" ;;
            cpu)     stress_args="--cpu $stress_workers --cpu-method all" ;;
            memory)  stress_args="--vm $stress_workers --vm-bytes 512M" ;;
            io)      stress_args="--io $stress_workers" ;;
            fork)    stress_args="--fork $stress_workers" ;;
            sched)   stress_args="--schedpolicy $stress_workers" ;;
            *)       echo "WARNING: unknown stress type: $stressor"; continue ;;
        esac
        echo "  launching: $stress_prefix stress-ng $stress_args --taskset $stress_cpus --timeout 0"
        $stress_prefix stress-ng $stress_args --taskset $stress_cpus --timeout 0 > stress-ng-${stressor}.log 2>&1 &
        stress_pids="$stress_pids $!"
    done
    sleep 3
    echo "  stress-ng pids: $stress_pids"
fi

date +%s.%N >rant-start.txt

$cmd_prefix $rant_bin $rant_args >rant-client-result.txt 2>&1
rc=$?

date +%s.%N >rant-stop.txt

if [ -n "$stress_pids" ]; then
    echo "=== stopping stress-ng ==="
    for pid in $stress_pids; do
        kill -TERM $pid 2>/dev/null
    done
    wait $stress_pids 2>/dev/null
fi

echo "rant client exited with rc=$rc"
if [ $rc -ne 0 ]; then
    echo "rant client failed:"
    cat rant-client-result.txt
fi

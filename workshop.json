{
    "workshop": {
        "schema": {
            "version": "2020.03.02"
        }
    },
    "userenvs": [
        {
            "name": "default",
            "requirements": [
                "rant_deps",
                "rant_src"
            ]
        }
    ],
    "requirements": [
        {
            "name": "rant_deps",
            "type": "distro",
            "distro_info": {
                "packages": [
                    "jq",
                    "bc",
                    "numactl",
                    "gcc",
                    "stress-ng"
                ]
            }
        },
        {
            "name": "rant_src",
            "type": "source",
            "source_info": {
                "url": "https://github.com/perftool-incubator/rant/archive/refs/heads/main.tar.gz",
                "filename": "rant-main.tar.gz",
                "commands": {
                    "unpack": "tar -xzf rant-main.tar.gz",
                    "get_dir": "tar -tzf rant-main.tar.gz | head -n 1",
                    "commands": [
                        "gcc -O2 -o /usr/local/bin/rant rant.c",
                        "/usr/local/bin/rant -h || true"
                    ]
                }
            }
        }
    ]
}
